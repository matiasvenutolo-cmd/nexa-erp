# Postgres (Neon vía la integración de Storage de Vercel). En desarrollo se
# obtienen con `npx vercel env pull .env.local --environment=preview` — no
# hace falta cargarlas a mano. DATABASE_URL_UNPOOLED es la que usa
# drizzle-kit (generate/migrate/push); DATABASE_URL es la pooled, la de la app.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Secreto para firmar la cookie de sesión. Generarlo con:
#   openssl rand -base64 32
# Distinto por entorno — nunca el mismo valor en dev y en la cuenta de CPS
# (ver docs/04-runbook-traspaso.md).
AUTH_SECRET=

# Vercel Blob — NO hace falta todavía. Se habilita en R4 (certificados de
# calidad escaneados) y R5 (remitos firmados). Lo provisiona la integración
# de Storage de Vercel cuando llegue el momento.
# BLOB_READ_WRITE_TOKEN=
